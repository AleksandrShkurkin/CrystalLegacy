  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9a3994f753553d40a7dc7985e8f430e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  allQuests:
  - questID: 0
    questName: Welcome!
    tasks:
    - taskType: 2
      taskDescription: Enter a portal into the game!
      targetID: Start
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines: []
    - taskType: 0
      taskDescription: Talk to Guide
      targetID: Guide
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines:
      - Welcome, traveler!
      - I'm always happy to see a new face. I'm the Guide, and I can give you your
        first quest!
      - Just go on the bridge and you'll reach a city!
    - taskType: 2
      taskDescription: Go to the City
      targetID: City
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines: []
    isSequential: 1
    isCompleted: 0
    reward:
      rewardType: 0
      materialType: 0
      amount: 0
      companion: {fileID: 0}
  - questID: 1
    questName: Second quest
    tasks:
    - taskType: 0
      taskDescription: Talk to a villager
      targetID: Villager
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines:
      - Hi, traveler! I need your help!
      - I'm this town's chef, so I cook for the town's folk.
      - But I'm all out of wood! And I can't go into the forest because of the orcs
        that live there.
      - You seem like a strong fellow, can you please bring me 5 Wood?
    - taskType: 2
      taskDescription: Go to the forest
      targetID: Forest
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines: []
    - taskType: 1
      taskDescription: Give villager 5 Wood
      targetID: Villager
      materialType: 0
      amount: 5
      isCompleted: 0
      dialogLines:
      - Thank you, kind man!
      - Here, take some money for your trouble. You can buy something from the store!
    isSequential: 1
    isCompleted: 0
    reward:
      rewardType: 3
      materialType: 0
      amount: 100
      companion: {fileID: 0}
  - questID: 2
    questName: We stuck gold!
    tasks:
    - taskType: 0
      taskDescription: Talk to a strange man
      targetID: Sneaky
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines:
      - Hey, come here...
      - Do you want to become rich?
      - Then go to the forest, fight the monsters, and at the end you'll find a cave...
      - It's filled with gold!! Sweet-sweet gold...
      - Bring me 3 Gold, I will sell them for a very good price... And the profit
        goes 50/50
      - How does that sound?
      - Good, now go...
    - taskType: 2
      taskDescription: Go to the cave
      targetID: Cave
      materialType: 0
      amount: 0
      isCompleted: 0
      dialogLines: []
    - taskType: 1
      taskDescription: Give strange man 3 Gold
      targetID: Sneaky
      materialType: 3
      amount: 3
      isCompleted: 0
      dialogLines:
      - Oooh, you've made it... That's good...
      - Give me the gold!
      - Here it is... All shiny...
      - Take this for your trouble... An early pay... He-he...
    isSequential: 0
    isCompleted: 0
    reward:
      rewardType: 1
      materialType: 1
      amount: 3
      companion: {fileID: 0}
  questText: {fileID: 0}
